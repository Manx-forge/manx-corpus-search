@using CorpusSearch.Model
@using CorpusSearch.Service

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Manx Corpus - Full Document Listing</title>
    @if (ViewData["CanonicalUrl"] != null)
    {
        <link rel="canonical" href="@ViewData["CanonicalUrl"]">
    }
    <link rel="shortcut icon" href="/favicon.ico">
    @* version query = server start time, so a rebuild+restart always busts cached CSS *@
    <link href="/site-chrome.css?v=@(System.Diagnostics.Process.GetCurrentProcess().StartTime.Ticks)" rel="stylesheet">
    <link href="/site-design.css?v=@(System.Diagnostics.Process.GetCurrentProcess().StartTime.Ticks)" rel="stylesheet">
</head>
<body>

@{
    ViewData["ActiveNav"] = "browse";
    var documents = ViewData["Documents"] as List<IDocument> ?? [];
    // the speech corpus's recordings, when ?corpus=speech asked for them
    var speech = ViewData["Speech"] as IReadOnlyCollection<SpeechDocument>;
    // the collections (or the one being listed), and the recordings in none
    var collections = ViewData["Collections"] as List<SpeechService.Collection> ?? [];
    var collection = ViewData["Collection"] as SpeechService.Collection;
    var platforms = new Dictionary<string, string>
    {
        ["youtube"] = "YouTube", ["manx_radio"] = "Manx Radio", ["learn_manx"] = "Learn Manx",
        ["clilstore"] = "Clilstore", ["common_voice"] = "Common Voice", ["saysomething"] = "Say Something in Manx",
    };
}

@await Html.PartialAsync("_SiteHeader")

<div class="page-main">
    <h1 class="page-title">@(speech == null ? "Full Document Listing" : collection?.Name ?? "Full Recording Listing")</h1>
    @if (collection != null)
    {
        <a class="browse-back" href="/Browse?corpus=speech">← All recordings</a>
    }

    <div class="browse-controls">
        <div class="seg-control">
            <a href="/Browse" class="@(speech == null ? "active" : null)">Text</a>
            <a href="/Browse?corpus=speech" class="@(speech != null ? "active" : null)">Speech</a>
        </div>
        <div class="browse-count">@(speech == null ? $"{documents.Count:N0} documents"
                                     : collections.Count > 0 ? $"{collections.Count} collections and {speech.Count:N0} other recordings"
                                     : $"{speech.Count:N0} recordings")</div>
        <div class="browse-order">
            <span class="browse-order-label">Order by</span>
            <div class="seg-control">
                <button type="button" id="order-date" class="active">Date</button>
                <button type="button" id="order-alpha">A–Z</button>
            </div>
        </div>
    </div>

    @if (speech != null)
    {
        <div class="browse-row browse-head">
            <span class="browse-year">Year</span>
            <span class="browse-text">Recording</span>
            <span class="browse-col">Source</span>
            <span class="browse-col">Domain</span>
            <span class="browse-col">Transcript</span>
            <span class="browse-col">Link</span>
        </div>
    }
    <div class="browse-list @(speech != null ? "browse-speech" : null)" id="browse-list">
        @foreach (var group in collections)
        {
            <div class="browse-row" data-title="@group.Name">
                <span class="browse-year">
                    @if (group.Years != null)
                    {
                        <span class="year-badge">@group.Years</span>
                    }
                </span>
                <span class="browse-text">
                    <a href="/Browse?corpus=speech&collection=@Uri.EscapeDataString(group.Key)">@group.Name</a>
                    <span class="browse-source">@group.Count.ToString("N0") recordings</span>
                </span>
                <span class="browse-col">@(platforms.GetValueOrDefault(group.Platform ?? "", group.Platform ?? ""))</span>
                <span class="browse-col">@group.Domain</span>
                <span class="browse-col">@(group.Origin == "asr" ? "AI" : "Human")</span>
                <span class="browse-col"></span>
            </div>
        }
        @if (speech != null)
        {
            @* dated first (most of the undated are single Common Voice sentences), then by title *@
            foreach (var recording in speech.OrderBy(x => x.CreatedCircaStart == null)
                         .ThenBy(x => x.CreatedCircaStart)
                         // numbers in order: Track 2 before Track 10
                         .ThenBy(x => x.Name, StringComparer.Create(System.Globalization.CultureInfo.InvariantCulture,
                             System.Globalization.CompareOptions.NumericOrdering | System.Globalization.CompareOptions.IgnoreCase))
                         .ThenBy(x => x.Ident, StringComparer.Ordinal))
            {
                var year = recording.GetFullYear();
                var host = Uri.TryCreate(recording.Source, UriKind.Absolute, out var url) ? url.Host.Replace("www.", "") : null;
                <div class="browse-row" data-title="@recording.Name">
                    <span class="browse-year">
                        @if (!string.IsNullOrEmpty(year))
                        {
                            <span class="year-badge">@year</span>
                        }
                    </span>
                    <span class="browse-text">
                        <a href="/speech/@Uri.EscapeDataString(recording.Ident)">@recording.Name</a>
                    </span>
                    <span class="browse-col">@(platforms.GetValueOrDefault(recording.Platform ?? "", recording.Platform ?? ""))</span>
                    <span class="browse-col">@recording.Domain</span>
                    <span class="browse-col">@(recording.Origin == "asr" ? "AI" : "Human")</span>
                    <span class="browse-col">
                        @if (host != null && recording.LinkStatus == "ok")
                        {
                            <a class="browse-link" href="@recording.Source" target="_blank" rel="noreferrer">@host</a>
                        }
                    </span>
                </div>
            }
        }
        else
        {
        foreach (var document in documents.OrderBy(x => x.CreatedCircaStart)
                      .ThenBy(x => x.Name, StringComparer.OrdinalIgnoreCase)
                      .ThenBy(x => x.Ident, StringComparer.Ordinal))
        {
            var year = document.GetFullYear();
            <div class="browse-row" data-title="@document.Name">
                <span class="browse-year">
                    @if (!string.IsNullOrEmpty(year))
                    {
                        <span class="year-badge">@year</span>
                    }
                </span>
                <span class="browse-text">
                    <a href="/docs/@Uri.EscapeDataString(document.Ident)">@document.Name</a>
                    @if (!string.IsNullOrEmpty(document.Source))
                    {
                        <span class="browse-source">@document.Source</span>
                    }
                </span>
            </div>
        }
        }
    </div>

    @await Html.PartialAsync("_SiteFooter")
</div>

<script>
    (function () {
        const list = document.getElementById("browse-list");
        const dateButton = document.getElementById("order-date");
        const alphaButton = document.getElementById("order-alpha");
        const byDate = Array.from(list.children);
        // sort on the first letter: ignore leading whitespace, quotes and emoji (e.g. "🎥 Captan…" under C)
        const sortKey = row => (row.dataset.title || "")
            .replace(/^[^\p{L}\p{N}]+/u, "")
            .toLowerCase();
        const byTitle = byDate.slice().sort((a, b) => sortKey(a).localeCompare(sortKey(b)));

        function show(rows, active, inactive) {
            list.replaceChildren(...rows);
            active.classList.add("active");
            inactive.classList.remove("active");
        }

        dateButton.addEventListener("click", () => show(byDate, dateButton, alphaButton));
        alphaButton.addEventListener("click", () => show(byTitle, alphaButton, dateButton));
    })();
</script>

</body>
</html>
